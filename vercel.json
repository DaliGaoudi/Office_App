{
  "version": 2,
  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["server/assets/**"] }
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "crons": [
    { "path": "/api/backup", "schedule": "0 3 * * *" }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server/index.js"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/client/assets/$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "/client/static/$1"
    },
    {
      "source": "/scan-bridge-setup.zip",
      "destination": "/client/scan-bridge-setup.zip"
    },
    {
       "source": "/((?!api/).*)",
       "destination": "/client/index.html"
    }
  ]
}
